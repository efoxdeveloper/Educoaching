generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id                         String                     @id @default(cuid())
  name                       String
  ownerName                  String
  email                      String                     @unique
  mobile                     String                     @unique
  emailVerified              Boolean                    @default(false)
  mobileVerified             Boolean                    @default(false)
  status                     InstituteStatus            @default(ACTIVE)
  address                    String?
  city                       String?
  state                      String?
  academicYearLabel          String?
  guidePhone                 String?
  instituteSlug              String?                    @unique
  settings                   Json?
  billingCycle               BillingCycle               @default(TRIAL)
  platformSubscriptionStatus PlatformSubscriptionStatus @default(TRIAL)
  currentPeriodAmount        Decimal?                   @db.Decimal(10, 2)
  trialStartedAt             DateTime                   @default(now())
  trialEndsAt                DateTime
  currentPeriodEnd           DateTime?
  expiryReminderSentAt       DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  admissions                 Admission[]
  assignments                Assignment[]
  attendance                 Attendance[]
  auditLogs                  AuditLog[]
  batches                    Batch[]
  batchFaculty               BatchFaculty[]
  branches                   Branch[]
  bulkCommunications         BulkCommunication[]
  issuedCertificates         CertificateIssued[]
  certificateTemplates       CertificateTemplate[]
  courses                    Course[]
  discountRequests           DiscountRequest[]
  emailVerifications         EmailVerificationToken[]
  expenses                   Expense[]
  faculty                    Faculty[]
  facultyReviews             FacultyReview[]
  feeReminderLogs            FeeReminderLog[]
  files                      FileAsset[]
  incomes                    Income[]
  leadFollowUps              LeadFollowUp[]
  liveClasses                LiveClass[]
  mobileOtps                 MobileOtp[]
  payments                   Payment[]
  paymentTransactions        PaymentTransaction[]
  notifications              PlatformNotification[]
  questions                  Question[]
  renewals                   Renewal[]
  staffAttendance            StaffAttendance[]
  students                   Student[]
  studyMaterials             StudyMaterial[]
  supportTickets             SupportTicket[]
  tests                      Test[]
  timetableSlots             TimetableSlot[]
  users                      User[]
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  instituteId String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
}

model MobileOtp {
  id          String    @id @default(cuid())
  instituteId String
  code        String
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
}

model PlatformNotification {
  id          String     @id @default(cuid())
  instituteId String?
  type        String
  message     String
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
}

model User {
  id                     String               @id @default(cuid())
  name                   String
  email                  String               @unique
  password               String
  role                   Role                 @default(ADMIN)
  instituteId            String?
  branchId               String?
  createdAt              DateTime             @default(now())
  auditLogs              AuditLog[]
  sentBulkCommunications BulkCommunication[]
  createdExpenses        Expense[]
  facultyProfiles        Faculty[]
  uploadedFiles          FileAsset[]
  createdIncomes         Income[]
  parentLinks            ParentStudentLink[]
  passwordResetTokens    PasswordResetToken[]
  uploadedStudyMaterials StudyMaterial[]
  supportTickets         SupportTicket[]
  branch                 Branch?              @relation(fields: [branchId], references: [id])
  institute              Institute?           @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
  @@index([branchId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id             String          @id @default(cuid())
  instituteId    String
  name           String
  fee            Decimal         @db.Decimal(10, 2)
  feeType        CourseFeeType   @default(ONE_TIME)
  description    String?
  duration       String?
  startDate      DateTime?
  endDate        DateTime?
  targetExam     String?
  eligibility    String?
  isAllBranches  Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  admissions     Admission[]
  assignments    Assignment[]
  batches        Batch[]
  institute      Institute       @relation(fields: [instituteId], references: [id])
  liveClasses    LiveClass[]
  students       Student[]
  studyMaterials StudyMaterial[]
  subjects       Subject[]
  tests          Test[]
  branches       Branch[]        @relation("BranchToCourse")

  @@index([instituteId])
}

model Branch {
  id               String       @id @default(cuid())
  instituteId      String
  name             String
  city             String?
  state            String?
  address          String?
  contact          String?
  guidePhone       String?
  isMainBranch     Boolean      @default(false)
  status           BranchStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  admissions       Admission[]
  batches          Batch[]      @relation("BranchPrimaryBatch")
  institute        Institute    @relation(fields: [instituteId], references: [id])
  expenses         Expense[]
  faculty          Faculty[]    @relation("FacultyPrimaryBranch")
  incomes          Income[]
  students         Student[]
  users            User[]
  allocatedBatches Batch[]      @relation("BatchBranches")
  courses          Course[]     @relation("BranchToCourse")
  allocatedFaculty Faculty[]    @relation("FacultyBranches")

  @@index([instituteId])
}

model Faculty {
  id              String          @id @default(cuid())
  instituteId     String
  name            String
  email           String?
  mobile          String?
  subject         String?
  subjects        String[]        @default([])
  qualification   String?
  experienceYears Int?
  bio             String?
  status          FacultyStatus   @default(ACTIVE)
  permissions     String[]        @default([])
  roleType        String          @default("FACULTY")
  department      String          @default("ACADEMIC")
  designation     String?
  monthlySalary   Decimal?        @db.Decimal(10, 2)
  branchId        String?
  isAllBranches   Boolean         @default(false)
  hasSystemAccess Boolean         @default(false)
  userId          String?
  joiningDate     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  admissions      Admission[]
  batches         BatchFaculty[]
  branch          Branch?         @relation("FacultyPrimaryBranch", fields: [branchId], references: [id])
  institute       Institute       @relation(fields: [instituteId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  reviews         FacultyReview[]
  liveClasses     LiveClass[]
  staffAttendance StaffAttendance[]
  timetableSlots  TimetableSlot[]
  branches        Branch[]        @relation("FacultyBranches")

  @@index([instituteId])
  @@index([branchId])
  @@index([roleType])
  @@index([department])
}

model BatchFaculty {
  id          String    @id @default(cuid())
  instituteId String
  batchId     String
  facultyId   String
  batch       Batch     @relation(fields: [batchId], references: [id])
  faculty     Faculty   @relation(fields: [facultyId], references: [id])
  institute   Institute @relation(fields: [instituteId], references: [id])

  @@unique([batchId, facultyId])
  @@index([instituteId])
}

model FacultyReview {
  id          String    @id @default(cuid())
  instituteId String
  facultyId   String
  studentId   String
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
  faculty     Faculty   @relation(fields: [facultyId], references: [id])
  institute   Institute @relation(fields: [instituteId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])

  @@index([instituteId])
}

model Batch {
  id               String          @id @default(cuid())
  instituteId      String
  name             String
  courseId         String
  timing           String
  capacity         Int             @default(40)
  branchCapacities Json?
  branchTimings    Json?
  status           String          @default("Active")
  startDate        DateTime?
  endDate          DateTime?
  branchId         String?
  isAllBranches    Boolean         @default(false)
  createdAt        DateTime        @default(now())
  admissions       Admission[]
  assignments      Assignment[]
  attendance       Attendance[]
  branch           Branch?         @relation("BranchPrimaryBatch", fields: [branchId], references: [id])
  course           Course          @relation(fields: [courseId], references: [id])
  institute        Institute       @relation(fields: [instituteId], references: [id])
  faculty          BatchFaculty[]
  liveClasses      LiveClass[]
  students         Student[]
  studyMaterials   StudyMaterial[]
  tests            Test[]
  timetableSlots   TimetableSlot[]
  branches         Branch[]        @relation("BatchBranches")

  @@index([instituteId])
  @@index([branchId])
}

model TimetableSlot {
  id          String    @id @default(cuid())
  instituteId String
  batchId     String
  facultyId   String?
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  room        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  batch       Batch     @relation(fields: [batchId], references: [id])
  faculty     Faculty?  @relation(fields: [facultyId], references: [id])
  institute   Institute @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
  @@index([batchId])
  @@index([facultyId])
}

model Subject {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([courseId, name])
  @@index([courseId])
}

model Student {
  id                     String                 @id @default(cuid())
  instituteId            String
  name                   String
  mobile                 String
  email                  String?
  parentMobile           String?
  courseId               String
  batchId                String?
  branchId               String?
  admissionDate          DateTime               @default(now())
  status                 StudentStatus          @default(ACTIVE)
  totalFee               Decimal                @db.Decimal(10, 2)
  paidFee                Decimal                @default(0) @db.Decimal(10, 2)
  dueDate                DateTime?
  photoUrl               String?
  createdAt              DateTime               @default(now())
  plan                   SubscriptionPlan       @default(MONTHLY)
  subscriptionStatus     SubscriptionStatus     @default(ACTIVE)
  demoStartedAt          DateTime?
  demoExpiresAt          DateTime?
  currentPeriodEnd       DateTime?
  monthlyAmount          Decimal?               @db.Decimal(10, 2)
  quarterlyAmount        Decimal?               @db.Decimal(10, 2)
  courseDuration         String?
  courseEndDate          DateTime?
  installmentPlan        Json?
  registrationFee        Decimal?               @db.Decimal(10, 2)
  isSeatBooked           Boolean                @default(false)
  discountPercent        Decimal?               @db.Decimal(5, 2)
  discountApprovalStatus String?
  parentEmail            String?
  admissions             Admission[]
  assignmentSubmissions  AssignmentSubmission[]
  attendance             Attendance[]
  issuedCertificates     CertificateIssued[]
  discountRequests       DiscountRequest[]
  reviews                FacultyReview[]
  feeReminderLogs        FeeReminderLog[]
  parentLinks            ParentStudentLink[]
  payments               Payment[]
  paymentTransactions    PaymentTransaction[]
  renewals               Renewal[]
  batch                  Batch?                 @relation(fields: [batchId], references: [id])
  branch                 Branch?                @relation(fields: [branchId], references: [id])
  course                 Course                 @relation(fields: [courseId], references: [id])
  institute              Institute              @relation(fields: [instituteId], references: [id])
  testAttempts           StudentTestAttempt[]
  testResults            TestResult[]

  @@index([instituteId])
  @@index([branchId])
}

model ParentStudentLink {
  id           String   @id @default(cuid())
  parentUserId String
  studentId    String
  createdAt    DateTime @default(now())
  parentUser   User     @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([parentUserId])
  @@index([studentId])
}

model DiscountRequest {
  id              String                @id @default(cuid())
  instituteId     String
  studentId       String?
  studentName     String
  studentMobile   String?
  courseId        String
  courseName      String
  originalFee     Decimal               @db.Decimal(10, 2)
  discountPercent Decimal               @db.Decimal(5, 2)
  discountAmount  Decimal               @db.Decimal(10, 2)
  finalFee        Decimal               @db.Decimal(10, 2)
  reason          String?
  requestedByRole String                @default("FACULTY")
  requestedByName String?
  status          DiscountRequestStatus @default(PENDING)
  decisionNotes   String?
  decisionAt      DateTime?
  decisionByName  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  institute       Institute             @relation(fields: [instituteId], references: [id])
  student         Student?              @relation(fields: [studentId], references: [id])

  @@index([instituteId])
  @@index([status])
}

model Admission {
  id                 String          @id @default(cuid())
  instituteId        String
  branchId           String?
  studentId          String?
  applicantName      String
  mobile             String
  email              String?
  photoUrl           String?
  courseId           String
  batchId            String?
  feePlan            Decimal         @db.Decimal(10, 2)
  status             AdmissionStatus @default(PENDING)
  source             String          @default("WALK_IN")
  stage              String          @default("NEW")
  priority           String          @default("WARM")
  nextFollowUpDate   DateTime?
  assignedTo         String?
  assignedToId       String?
  note               String?
  demoDate           DateTime?
  demoStatus         String?
  demoFeedback       String?
  lostReason         String?
  lostNotes          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  assignedCounsellor Faculty?        @relation(fields: [assignedToId], references: [id])
  batch              Batch?          @relation(fields: [batchId], references: [id])
  branch             Branch?         @relation(fields: [branchId], references: [id])
  course             Course          @relation(fields: [courseId], references: [id])
  institute          Institute       @relation(fields: [instituteId], references: [id])
  student            Student?        @relation(fields: [studentId], references: [id])
  followUps          LeadFollowUp[]

  @@index([instituteId])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([assignedToId])
}

model LeadFollowUp {
  id          String    @id @default(cuid())
  instituteId String
  admissionId String
  counsellor  String
  callStatus  String
  notes       String
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id])

  @@index([instituteId])
  @@index([admissionId])
}

model Attendance {
  id          String           @id @default(cuid())
  instituteId String
  studentId   String
  batchId     String
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  locked      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  batch       Batch            @relation(fields: [batchId], references: [id])
  institute   Institute        @relation(fields: [instituteId], references: [id])
  student     Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([instituteId])
}

model StaffAttendance {
  id          String                @id @default(cuid())
  instituteId String
  facultyId   String
  date        DateTime              @db.Date
  status      StaffAttendanceStatus @default(PRESENT)
  checkIn     String?
  checkOut    String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  faculty     Faculty               @relation(fields: [facultyId], references: [id])
  institute   Institute             @relation(fields: [instituteId], references: [id])

  @@unique([facultyId, date])
  @@index([instituteId])
}

model Payment {
  id                String    @id @default(cuid())
  instituteId       String
  studentId         String
  amount            Decimal   @db.Decimal(10, 2)
  baseAmount        Decimal?  @db.Decimal(10, 2)
  gstAmount         Decimal?  @db.Decimal(10, 2)
  gstPercent        Decimal?  @db.Decimal(5, 2)
  isRefund          Boolean   @default(false)
  refundReason      String?
  receiptFileId     String?
  method            String    @default("Cash")
  paidAt            DateTime  @default(now())
  note              String?
  razorpayOrderId   String?
  razorpayPaymentId String?   @unique
  status            String    @default("SUCCESS")
  installmentNumber Int?
  installmentTitle  String?
  institute         Institute @relation(fields: [instituteId], references: [id])
  student           Student   @relation(fields: [studentId], references: [id])

  @@index([instituteId])
  @@index([studentId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model Renewal {
  id          String    @id @default(cuid())
  instituteId String
  studentId   String
  amount      Decimal   @db.Decimal(10, 2)
  method      String    @default("Cash")
  planType    String    @default("MONTHLY")
  renewedAt   DateTime  @default(now())
  validFrom   DateTime
  validUntil  DateTime
  note        String?
  institute   Institute @relation(fields: [instituteId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])

  @@index([instituteId])
}

model AuditLog {
  id          String     @id @default(cuid())
  instituteId String?
  userId      String?
  actorName   String
  actorRole   String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  institute   Institute? @relation(fields: [instituteId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@index([instituteId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FileAsset {
  id               String       @id @default(cuid())
  instituteId      String
  uploadedByUserId String?
  category         FileCategory @default(OTHER)
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String       @unique
  relatedType      String?
  relatedId        String?
  createdAt        DateTime     @default(now())
  institute        Institute    @relation(fields: [instituteId], references: [id])
  uploadedBy       User?        @relation(fields: [uploadedByUserId], references: [id])

  @@index([instituteId])
  @@index([relatedType, relatedId])
}

model Test {
  id               String               @id @default(cuid())
  instituteId      String
  batchId          String
  courseId         String?
  title            String
  subject          String?
  testDate         DateTime             @db.Date
  totalMarks       Float
  passingMarks     Float?
  description      String?
  isOnline         Boolean              @default(false)
  durationMinutes  Int?                 @default(60)
  startTime        DateTime?
  endTime          DateTime?
  negativeMarks    Float?               @default(1)
  marksPerQuestion Float?               @default(4)
  status           String               @default("DRAFT")
  seriesName       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  attempts         StudentTestAttempt[]
  batch            Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course           Course?              @relation(fields: [courseId], references: [id])
  institute        Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  questions        TestQuestion[]
  results          TestResult[]

  @@index([instituteId])
  @@index([batchId])
  @@index([courseId])
}

model TestResult {
  id            String   @id @default(cuid())
  testId        String
  studentId     String
  marksObtained Float?
  isAbsent      Boolean  @default(false)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@index([testId])
  @@index([studentId])
}

model Question {
  id            String         @id @default(cuid())
  instituteId   String
  subject       String
  topic         String?
  difficulty    String         @default("MEDIUM")
  type          String         @default("MCQ_SINGLE")
  questionText  String
  options       Json?
  correctAnswer String
  explanation   String?
  marks         Float          @default(4)
  negativeMarks Float          @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institute     Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  testQuestions TestQuestion[]

  @@index([instituteId])
  @@index([subject])
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  questionId String
  order      Int      @default(0)
  section    String?
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId])
}

model StudentTestAttempt {
  id               String    @id @default(cuid())
  testId           String
  studentId        String
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  status           String    @default("IN_PROGRESS")
  answers          Json?
  score            Float?
  totalCorrect     Int       @default(0)
  totalIncorrect   Int       @default(0)
  totalUnattempted Int       @default(0)
  percentile       Float?
  rank             Int?
  timeSpentSeconds Int       @default(0)
  createdAt        DateTime  @default(now())
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test             Test      @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@index([testId])
  @@index([studentId])
}

model StudyMaterial {
  id               String    @id @default(cuid())
  instituteId      String
  courseId         String?
  batchId          String?
  subject          String
  topic            String?
  title            String
  description      String?
  fileType         String    @default("PDF")
  fileUrl          String
  fileSizeBytes    Int?
  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  batch            Batch?    @relation(fields: [batchId], references: [id])
  course           Course?   @relation(fields: [courseId], references: [id])
  institute        Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  uploadedBy       User?     @relation(fields: [uploadedByUserId], references: [id])

  @@index([instituteId])
  @@index([courseId])
  @@index([batchId])
}

model Assignment {
  id            String                 @id @default(cuid())
  instituteId   String
  batchId       String
  courseId      String?
  title         String
  subject       String
  type          String                 @default("HOMEWORK")
  description   String?
  attachmentUrl String?
  dueDate       DateTime
  totalMarks    Float?                 @default(100)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  batch         Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course        Course?                @relation(fields: [courseId], references: [id])
  institute     Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  submissions   AssignmentSubmission[]

  @@index([instituteId])
  @@index([batchId])
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String
  studentId     String
  submissionUrl String?
  notes         String?
  submittedAt   DateTime   @default(now())
  status        String     @default("SUBMITTED")
  marksObtained Float?
  feedback      String?
  evaluatedAt   DateTime?
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model PaymentTransaction {
  id             String    @id @default(cuid())
  instituteId    String
  studentId      String
  amount         Decimal   @db.Decimal(10, 2)
  purpose        String    @default("fee")
  status         String    @default("PENDING")
  orderId        String    @unique
  paymentId      String?   @unique
  signature      String?
  method         String?
  failureReason  String?
  notes          String?
  webhookPayload Json?
  reconciled     Boolean   @default(false)
  reconciledAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([studentId])
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}

model FeeReminderLog {
  id          String    @id @default(cuid())
  instituteId String
  studentId   String
  channel     String
  recipient   String
  amountDue   Decimal   @db.Decimal(10, 2)
  dueDate     DateTime?
  status      String    @default("SENT")
  message     String?
  sentAt      DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([studentId])
  @@index([sentAt])
}

model Expense {
  id              String          @id @default(cuid())
  instituteId     String
  title           String
  amount          Decimal         @db.Decimal(10, 2)
  category        ExpenseCategory @default(OTHER)
  paymentMethod   String          @default("Cash")
  expenseDate     DateTime        @db.Date
  paidTo          String?
  notes           String?
  receiptUrl      String?
  createdByUserId String?
  branchId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  branch          Branch?         @relation(fields: [branchId], references: [id])
  createdBy       User?           @relation(fields: [createdByUserId], references: [id])
  institute       Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([branchId])
  @@index([category])
  @@index([expenseDate])
}

model Income {
  id              String         @id @default(cuid())
  instituteId     String
  title           String
  amount          Decimal        @db.Decimal(10, 2)
  category        IncomeCategory @default(OTHER)
  paymentMethod   String         @default("Cash")
  incomeDate      DateTime       @db.Date
  receivedFrom    String?
  notes           String?
  receiptUrl      String?
  createdByUserId String?
  branchId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  branch          Branch?        @relation(fields: [branchId], references: [id])
  createdBy       User?          @relation(fields: [createdByUserId], references: [id])
  institute       Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([branchId])
  @@index([category])
  @@index([incomeDate])
}

model BulkCommunication {
  id             String               @id @default(cuid())
  instituteId    String
  title          String
  channel        CommunicationChannel @default(WHATSAPP)
  targetAudience TargetAudience       @default(ALL_STUDENTS)
  filterDetails  Json?
  message        String
  recipientCount Int                  @default(0)
  sentCount      Int                  @default(0)
  failedCount    Int                  @default(0)
  senderUserId   String?
  sentAt         DateTime             @default(now())
  institute      Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  sender         User?                @relation(fields: [senderUserId], references: [id])

  @@index([instituteId])
  @@index([sentAt])
}

model LiveClass {
  id              String          @id @default(cuid())
  instituteId     String
  batchId         String?
  courseId        String?
  facultyId       String?
  subject         String?
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  meetingLink     String
  status          LiveClassStatus @default(SCHEDULED)
  reminderSent    Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  batch           Batch?          @relation(fields: [batchId], references: [id])
  course          Course?         @relation(fields: [courseId], references: [id])
  faculty         Faculty?        @relation(fields: [facultyId], references: [id])
  institute       Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([batchId])
  @@index([courseId])
  @@index([facultyId])
  @@index([scheduledAt])
  @@index([status])
}

model CertificateTemplate {
  id                   String              @id @default(cuid())
  instituteId          String
  name                 String
  title                String              @default("Certificate of Completion")
  bodyText             String              @default("This is to certify that {studentName} has successfully completed the course {courseName} on {completionDate} at {instituteName}.")
  logoFileAssetId      String?
  signatureFileAssetId String?
  signatoryName        String?             @default("Authorized Signatory")
  signatoryTitle       String?             @default("Director / Academic Head")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  issuedCertificates   CertificateIssued[]
  institute            Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
}

model CertificateIssued {
  id             String              @id @default(cuid())
  instituteId    String
  studentId      String
  templateId     String
  issuedAt       DateTime            @default(now())
  pdfFileAssetId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  institute      Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template       CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([studentId, templateId])
  @@index([instituteId])
  @@index([studentId])
  @@index([templateId])
}

model SupportTicket {
  id          String    @id @default(cuid())
  instituteId String
  userId      String?
  subject     String
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([instituteId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

